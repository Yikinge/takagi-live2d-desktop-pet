    "keyboard.left": {
      "ParamKeyHandZone": -1,
      "ParamKeyPress": 1
    },
    "keyboard.center": {
      "ParamKeyHandZone": 0,
      "ParamKeyPress": 1
    },
    "keyboard.right": {
      "ParamKeyHandZone": 0.6,
      "ParamKeyPress": 1
    },
    "keyboard.space": {
      "ParamKeyHandZone": 0,
      "ParamSpacePress": 1
    },
    "keyboard.enter": {
      "ParamKeyHandZone": 1,
      "ParamEnterPress": 1
    },
    "keyboard.backspace": {
      "ParamKeyHandZone": 0.8,
      "ParamBackspacePress": 1
    },
    "mouse.move": [
      "ParamMouseHandX",
      "ParamMouseHandY"
    ],
    "mouse.left": {
      "ParamMouseLeftClick": 1
    },
    "mouse.right": {
      "ParamMouseRightClick": 1
    },
    "mouse.wheelUp": {
      "ParamMouseWheel": 1
    },
    "mouse.wheelDown": {
      "ParamMouseWheel": -1
    }
